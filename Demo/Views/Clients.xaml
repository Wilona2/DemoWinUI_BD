<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Demo.Views.Clients"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Demo.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer>

        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  En-tête  -->
            <TextBlock
                Grid.Row="0"
                FontSize="28"
                FontWeight="SemiBold"
                Text="Clients" />

            <!--  Actions  -->
            <StackPanel
                Grid.Row="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="btn_AjouterClick" Content="Ajouter un client" />
                <Button Click="btn_ModifierClick" Content="Modifier" />
                <Button Click="btn_SupprimerClick" Content="Supprimer" />
            </StackPanel>


            <!--  Liste des clients  -->
            <Border
                Grid.Row="2"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Border
                        Padding="16,10"
                        Background="Azure"
                        CornerRadius="8,8,0,0">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Liste des clients" />
                    </Border>

                    <GridView
                        Height="320"
                        Margin="8"
                        ItemsSource="{x:Bind ViewModel.Clients, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.ClientSelectionne, Mode=TwoWay}">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ClientViewModel">
                                <Border
                                    Width="250"
                                    Height="120"
                                    Padding="12"
                                    Background="White"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Prenom}" />
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Nom}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="Client depuis :" />
                                            <TextBlock Text="{x:Bind DateCreation}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="Gâteau préféré :" />
                                            <TextBlock Text="{x:Bind GateauPreferee}" />
                                        </StackPanel>
                                        <TextBlock
                                            FontStyle="Italic"
                                            Text="Client régulier"
                                            Visibility="{x:Bind EstClientRegulier}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Border>


        </Grid>
    </ScrollViewer>
</Page>
